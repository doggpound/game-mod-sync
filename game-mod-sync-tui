#!/usr/bin/env bash
# Kept so existing links keep working: same as `game-mod-sync --tui`.
_self=${BASH_SOURCE[0]}
while [ -L "$_self" ]; do
  _dir=$(cd -P "$(dirname "$_self")" && pwd)
  _self=$(readlink "$_self")
  case $_self in /*) ;; *) _self="$_dir/$_self" ;; esac
done
exec "$(cd -P "$(dirname "$_self")" && pwd)/game-mod-sync" --tui "$@"
